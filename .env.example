# Copy to .env (never commit .env)

# --- LLM: Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- LangSmith tracing (https://smith.langchain.com) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=workweave

# --- Sign-in: Google OAuth (https://console.cloud.google.com/apis/credentials -> OAuth client ID, "Web application") ---
# Authorised redirect URI to add there:  <BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BASE_URL=http://localhost:8000    # the public address of this app (https://your-app.onrender.com in production)
SECRET_KEY=                       # any long random string; signs the short sign-in handshake cookie

# --- Accounts database (users, sessions, what they searched for). Leave empty locally: uses data/users.db (SQLite).
# In production set a Postgres URL (Render Postgres, Neon, Supabase...):  postgresql://user:pass@host/dbname
DATABASE_URL=

# --- Listing source (apna.co, scraped politely; no key needed) ---
SCRAPER_MIN_INTERVAL_S=2.5       # seconds between requests
REFRESH_TTL_HOURS=0.25           # re-check apna.co when a trade's listings are older than this
AUTO_REFRESH_MINUTES=0           # 0 = never scrape in the background

# --- Storage (relative to the project root) ---
DB_PATH=data/listings.db          # listings only (a re-scrapable cache)
CACHE_DB_PATH=data/llm_cache.db   # cached LLM answers
CHROMA_DIR=data/chroma
